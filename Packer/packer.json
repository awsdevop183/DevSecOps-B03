{
    "_comment": "AMI Image With Docker & Nginx",
    "variables": {
        "region": "",
        "source_ami": "",
        "instance_type": "",
        "vpc_id": "",
        "subnet_id": ""
    },
    "_comment2": "packer build -var-file vars.json packer.json",
    "builders": [
        {
            "type": "amazon-ebs",
            "region": "{{user `region`}}",
            "source_ami": "{{user `source_ami`}}",
            "instance_type": "{{user `instance_type`}}",
            "ssh_username": "ubuntu",
            "ami_name": "DevSecOps-B03-{{isotime | clean_resource_name}}",
            "vpc_id": "{{user `vpc_id`}}",
            "subnet_id": "{{user `subnet_id`}}",
            "tags": {
                "Name": "AWS-B11-{{isotime | clean_resource_name}}"
            }
        }
    ],
    "provisioners": [
        {
            "type": "shell",
            "inline": [
                "sudo useradd -m madhu --shell /bin/bash",
                "sudo mkdir -p /home/madhu/.ssh",
                "sudo chown -R madhu /home/madhu/",
                "sudo touch /home/madhu/.ssh/authorized_keys",
                "sudo usermod -aG sudo madhu",
                "echo 'madhu ALL=(ALL) NOPASSWD: ALL' | sudo tee -a /etc/sudoers",
                "echo 'ssh-rsa  madhukerreddybadala@Madhukar-Reddys-MacBook-Pro.local' | sudo tee /home/madhu/.ssh/authorized_keys"
            ]
        },
        {
            "type": "shell",
            "inline": [
                "sudo apt update -y",
                "sudo apt install -y unzip, net-tools",
                "curl https://get.docker.com | bash"
            ]
        }
    ]
}