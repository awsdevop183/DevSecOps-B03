Must Choose Ubuntu 24.04

sudo apt update
sudo apt upgrade -y

sudo apt install -y \
  curl \
  wget \
  gnupg \
  ca-certificates \
  net-tools

sudo mkdir -p /usr/share/keyrings

curl -fsSL \
  https://releases.jfrog.io/artifactory/api/v2/repositories/artifactory-debs/keyPairs/primary/public \
  | sudo gpg --dearmor -o /usr/share/keyrings/jfrog-artifactory.gpg

echo "deb [signed-by=/usr/share/keyrings/jfrog-artifactory.gpg] https://releases.jfrog.io/artifactory/artifactory-debs $(. /etc/os-release && echo "$VERSION_CODENAME") main" \
  | sudo tee /etc/apt/sources.list.d/jfrog-artifactory.list

sudo apt update

sudo apt install -y jfrog-artifactory-oss
sudo systemctl status artifactory
