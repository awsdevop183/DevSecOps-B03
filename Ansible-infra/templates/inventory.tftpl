${node.name} ansible_host=${node.public_ip} private_ip=${node.private_ip} ansible_ssh_private_key_file=${private_key_path} ansible_user=${ssh_user}
%{ endfor ~}

[controller]
${controller.name} ansible_host=${controller.public_ip} private_ip=${controller.private_ip} ansible_user=${ssh_user} ansible_ssh_private_key_file=${private_key_path}


