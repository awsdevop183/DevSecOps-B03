# Generated by Terraform - do not edit by hand.
# Re-run `terraform apply` to refresh.

[nodes]
%{ for node in nodes ~}
${node.name} ansible_host=${node.public_ip} private_ip=${node.private_ip}
%{ endfor ~}

[nodes:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${private_key_path}
ansible_ssh_common_args='-o StrictHostKeyChecking=no'

[controller]
${controller.name} ansible_host=${controller.public_ip} private_ip=${controller.private_ip}

[controller:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${private_key_path}
